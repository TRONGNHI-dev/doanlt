@model TravelProject.Models.User

@{
    ViewData["Title"] = "Edit User";
}

<style>
    .user-form-page {
        position: relative;
        z-index: 5;
        padding: 24px 0 40px;
    }

    .user-form-hero {
        background: linear-gradient(135deg, #fff6ef 0%, #ffffff 55%, #eef4ff 100%);
        border: 1px solid #f0e4d7;
        border-radius: 28px;
        padding: 32px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.08);
        margin-bottom: 24px;
    }

    .user-form-badge {
        display: inline-flex;
        align-items: center;
        padding: 8px 14px;
        border-radius: 999px;
        background: rgba(255, 122, 61, 0.12);
        color: #d75a1a;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-bottom: 14px;
    }

    .user-form-title {
        margin: 0;
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 800;
        color: #172033;
        line-height: 1.1;
    }

    .user-form-subtitle {
        margin: 12px 0 0;
        max-width: 680px;
        color: #5f6b85;
        font-size: 16px;
    }

    .user-form-card {
        background: #fff;
        border: 1px solid #e8edf5;
        border-radius: 24px;
        box-shadow: 0 18px 40px rgba(15, 23, 42, 0.06);
        overflow: hidden;
    }

    .user-form-card__header {
        padding: 24px 28px;
        border-bottom: 1px solid #eef2f7;
    }

    .user-form-card__title {
        margin: 0;
        font-size: 22px;
        font-weight: 800;
        color: #172033;
    }

    .user-form-card__meta {
        margin: 8px 0 0;
        color: #7b879d;
        font-size: 14px;
    }

    .user-form-body {
        padding: 28px;
    }

    .user-form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
    }

    .user-form-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .user-form-group--full {
        grid-column: 1 / -1;
    }

    .user-form-label {
        font-size: 14px;
        font-weight: 700;
        color: #24324d;
    }

    .user-form-control,
    .user-form-select {
        width: 100%;
        min-height: 54px;
        border-radius: 16px;
        border: 1px solid #dbe3f0;
        padding: 0 16px;
        font-size: 15px;
        color: #172033;
        background: #fff;
        box-shadow: inset 0 1px 2px rgba(15, 23, 42, 0.03);
    }

    .user-form-control:focus,
    .user-form-select:focus {
        outline: none;
        border-color: #ff7a3d;
        box-shadow: 0 0 0 4px rgba(255, 122, 61, 0.12);
    }

    .validation-summary-errors,
    .field-validation-error {
        color: #d14343;
        font-size: 13px;
    }

    .validation-summary-errors ul {
        margin: 0 0 16px;
        padding-left: 18px;
    }

    .user-form-actions {
        display: flex;
        gap: 12px;
        margin-top: 28px;
        flex-wrap: wrap;
    }

    .user-form-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 52px;
        padding: 0 20px;
        border-radius: 16px;
        font-weight: 700;
        text-decoration: none;
        border: none;
    }

    .user-form-btn--primary {
        background: linear-gradient(135deg, #ff7a3d 0%, #ff5c35 100%);
        color: #fff;
        box-shadow: 0 14px 30px rgba(255, 92, 53, 0.22);
    }

    .user-form-btn--secondary {
        background: #15213b;
        color: #fff;
    }

    @@media (max-width: 767.98px) {
        .user-form-hero,
        .user-form-card__header,
        .user-form-body {
            padding: 20px;
        }

        .user-form-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<section class="user-form-page">
    <div class="user-form-hero">
        <div class="user-form-badge">Pacific Travel Agency</div>
        <h1 class="user-form-title">Edit User</h1>
        <p class="user-form-subtitle">Update the selected user while keeping the same structure used in the list view.</p>
    </div>

    <div class="user-form-card">
        <div class="user-form-card__header">
            <h2 class="user-form-card__title">User Information</h2>
            <p class="user-form-card__meta">Review and update the fields below, then save your changes.</p>
        </div>

        <div class="user-form-body">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />
                <input asp-for="CreatedAt" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <div class="user-form-grid">
                    <div class="user-form-group">
                        <label asp-for="Username" class="user-form-label"></label>
                        <input asp-for="Username" class="user-form-control" placeholder="Enter username" />
                        <span asp-validation-for="Username" class="field-validation-error"></span>
                    </div>

                    <div class="user-form-group">
                        <label asp-for="Password" class="user-form-label"></label>
                        <input asp-for="Password" type="password" class="user-form-control" placeholder="Enter password" />
                        <span asp-validation-for="Password" class="field-validation-error"></span>
                    </div>

                    <div class="user-form-group">
                        <label asp-for="FullName" class="user-form-label"></label>
                        <input asp-for="FullName" class="user-form-control" placeholder="Enter full name" />
                        <span asp-validation-for="FullName" class="field-validation-error"></span>
                    </div>

                    <div class="user-form-group">
                        <label asp-for="Email" class="user-form-label"></label>
                        <input asp-for="Email" class="user-form-control" placeholder="Enter email address" />
                        <span asp-validation-for="Email" class="field-validation-error"></span>
                    </div>

                    <div class="user-form-group">
                        <label asp-for="PhoneNumber" class="user-form-label"></label>
                        <input asp-for="PhoneNumber" class="user-form-control" placeholder="Enter phone number" />
                        <span asp-validation-for="PhoneNumber" class="field-validation-error"></span>
                    </div>

                    <div class="user-form-group">
                        <label asp-for="Role" class="user-form-label"></label>
                        <select asp-for="Role" class="user-form-select">
                            <option value="User">User</option>
                            <option value="Staff">Staff</option>
                            <option value="Admin">Admin</option>
                        </select>
                        <span asp-validation-for="Role" class="field-validation-error"></span>
                    </div>

                    <div class="user-form-group user-form-group--full">
                        <label asp-for="Status" class="user-form-label">Status</label>
                        <select asp-for="Status" class="user-form-select">
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </select>
                        <span asp-validation-for="Status" class="field-validation-error"></span>
                    </div>
                </div>

                <div class="user-form-actions">
                    <button type="submit" class="user-form-btn user-form-btn--primary">Save Changes</button>
                    <a asp-action="Index" class="user-form-btn user-form-btn--secondary">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
