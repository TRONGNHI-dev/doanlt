@model TravelProject.Models.DiaDiem

@{
    ViewData["Title"] = "Delete Destination";
}

<style>
    .dd-delete-page { padding: 24px 0 40px; }
    .dd-delete-hero {
        background: linear-gradient(135deg, #fff3f1 0%, #ffffff 55%, #fff7f5 100%);
        border: 1px solid #f8d9d2;
        border-radius: 28px;
        padding: 32px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.08);
        margin-bottom: 24px;
    }
    .dd-badge {
        display: inline-flex;
        padding: 8px 14px;
        border-radius: 999px;
        background: rgba(217, 72, 15, 0.12);
        color: #c2410c;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-bottom: 14px;
    }
    .dd-title { margin: 0; font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; color: #172033; }
    .dd-subtitle { margin: 12px 0 0; color: #6b7280; font-size: 16px; max-width: 700px; }
    .dd-card {
        background: #fff;
        border: 1px solid #f1d8d4;
        border-radius: 24px;
        box-shadow: 0 18px 40px rgba(15, 23, 42, 0.06);
        overflow: hidden;
    }
    .dd-summary {
        padding: 28px;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px 24px;
        border-bottom: 1px solid #f4e4e1;
    }
    .dd-item {
        padding: 18px 20px;
        border-radius: 18px;
        background: #fffaf9;
        border: 1px solid #f8e2dd;
    }
    .dd-label { display: block; margin-bottom: 8px; font-size: 13px; font-weight: 700; text-transform: uppercase; color: #8b95a7; }
    .dd-value { margin: 0; font-size: 17px; font-weight: 700; color: #172033; }
    .dd-actions { display: flex; gap: 12px; padding: 24px 28px; flex-wrap: wrap; }
    .dd-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 52px;
        padding: 0 20px;
        border-radius: 16px;
        font-weight: 700;
        text-decoration: none;
        border: none;
    }
    .dd-btn--danger { background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); color: #fff; }
    .dd-btn--secondary { background: #15213b; color: #fff; }
    @@media (max-width: 767.98px) { .dd-summary { grid-template-columns: 1fr; } }
</style>

<section class="dd-delete-page">
    <div class="dd-delete-hero">
        <div class="dd-badge">Danger Zone</div>
        <h1 class="dd-title">Delete Destination</h1>
        <p class="dd-subtitle">This action permanently removes the selected destination from the management module.</p>
    </div>

    <div class="dd-card">
        <div class="dd-summary">
            <div class="dd-item">
                <span class="dd-label">Destination Name</span>
                <p class="dd-value">@Model.TenDiaDiem</p>
            </div>
            <div class="dd-item">
                <span class="dd-label">Region</span>
                <p class="dd-value">@Model.KhuVuc</p>
            </div>
            <div class="dd-item">
                <span class="dd-label">Category</span>
                <p class="dd-value">@Model.LoaiHinh</p>
            </div>
            <div class="dd-item">
                <span class="dd-label">Views</span>
                <p class="dd-value">@Model.LuotXem</p>
            </div>
            <div class="dd-item">
                <span class="dd-label">Address</span>
                <p class="dd-value">@Model.DiaChi</p>
            </div>
            <div class="dd-item">
                <span class="dd-label">Created Date</span>
                <p class="dd-value">@Model.CreatedDate.ToString("dd/MM/yyyy")</p>
            </div>
        </div>
        <div class="dd-actions">
            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />
                <button type="submit" class="dd-btn dd-btn--danger">Confirm Delete</button>
            </form>
            <a asp-action="Index" class="dd-btn dd-btn--secondary">Cancel</a>
        </div>
    </div>
</section>
